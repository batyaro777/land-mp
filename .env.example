# Секрет для cookie-сессий: любой случайный hex, например `openssl rand -hex 32`
LANDCHECK_SECRET=
# Прокси к НСПД, если сервер вне зоны, откуда НСПД отвечает (socks5://host:port или http://...)
LANDCHECK_PROXY=
# Публичный адрес сервиса без завершающего слеша — для ссылок клиентам и фото в Avito XML
LANDCHECK_BASE_URL=https://land.example.com
# Название в шапке
LANDCHECK_BRAND=Проверка участков
# Параллельных запросов к НСПД на одну проверку
LANDCHECK_WORKERS=2
# Офлайн-режим на фикстурах (путь к папке JSON) — для демо без сети
# LANDCHECK_FIXTURES=/app/examples/fixtures
# Модуль «Регион» (сводка по локации через Gemini с поиском Google) и голосовой ввод (расшифровка
# речи той же моделью). Без ключа блок «Регион» и кнопки «Голосом» выключены.
# Квота на поиск Google есть только у проекта с биллингом в Google AI Studio.
GEMINI_API_KEY=
LANDCHECK_GEMINI_MODEL=gemini-3.8-flash
