# Секрет для cookie-сессий: любой случайный hex, например `openssl rand -hex 32`
LANDCHECK_SECRET=
# Прокси к НСПД, если сервер вне зоны, откуда НСПД отвечает (socks5://host:port или http://...)
LANDCHECK_PROXY=
# Публичный адрес сервиса без завершающего слеша — для ссылок клиентам и фото в Avito XML
LANDCHECK_BASE_URL=https://land.example.com
# Название в шапке
LANDCHECK_BRAND=Проверка участков
# Параллельных запросов к НСПД на одну проверку
LANDCHECK_WORKERS=2
# Офлайн-режим на фикстурах (путь к папке JSON) — для демо без сети
# LANDCHECK_FIXTURES=/app/examples/fixtures
# --- Бесплатный стек (решение 19.10.2026): языковая модель, поиск, распознавание речи ---
# Groq: бесплатный уровень без карты (console.groq.com). Даёт и модель (gpt-oss-120b, Qwen 3.8),
# и Whisper для голоса. Этого ключа достаточно для «Региона», автоупаковки и серверного голоса.
GROQ_API_KEY=
# Запасные бесплатные провайдеры модели (необязательно): OpenRouter (:free, 50 запросов/день
# без кредитов), Mistral (бесплатный уровень по телефону).
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Порядок провайдеров модели и их модели (по умолчанию как ниже)
LANDCHECK_LLM=groq,openrouter,mistral
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
# Поиск для «Региона»: свой SearXNG (format=json включён в settings.yml) — лучше по качеству
# и без лимитов; без него — DuckDuckGo через ddgs (без ключа).
SEARXNG_URL=
# Режим «Региона»: search (бесплатно, по умолчанию) или gemini (платный grounding)
LANDCHECK_REGION=search
# Серверное распознавание речи: groq (Whisper, бесплатно), elevenlabs (Scribe v2 по подписке,
# ELEVENLABS_API_KEY), local (faster-whisper в контейнере, сборка с --build-arg ASR_LOCAL=1),
# gemini. В браузере первым работает Web Speech API.
LANDCHECK_ASR=groq,elevenlabs,local,gemini
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# LANDCHECK_WHISPER_MODEL=large-v3-turbo
# Gemini — только как опция (платный уровень): grounding, голос и текст, если ключ оставлен.
GEMINI_API_KEY=
LANDCHECK_GEMINI_MODEL=gemini-3.8-flash
